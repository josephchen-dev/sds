#!/bin/bash
set -e

# Waits for the Vite dev server to be ready to serve requests.
HEALTHCHECK_URL="http://localhost:8000/"
MAX_WAIT=120 # 2 minutes
INTERVAL=2
ELAPSED=0

echo "Waiting for dev server at ${HEALTHCHECK_URL} ..."

while [ $ELAPSED -lt $MAX_WAIT ]; do
  if curl -sf "$HEALTHCHECK_URL" >/dev/null 2>&1; then
    echo "Dev server is up."
    exit 0
  fi
  sleep $INTERVAL
  ELAPSED=$((ELAPSED + INTERVAL))
done

echo "Error: Dev server did not start within ${MAX_WAIT}s"
exit 1

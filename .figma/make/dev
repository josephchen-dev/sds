#!/usr/bin/env bash
# Starts the Vite dev server. Runs for the whole session; killed on close.
set -euo pipefail

cd "$(dirname "$0")/../.."

# Load PORT (and any other vars) from the env file next to this script.
set -a
. "$(dirname "$0")/env"
set +a

exec npx vite --host --port "${PORT}" --strictPort
